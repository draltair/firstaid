{
  "id": "ich-score",
  "categoria": "calcolatori",
  "titolo": "ICH Score",
  "contenuto": {
    "ambito": "Emorragia cerebrale spontanea — mortalità a 30 giorni",
    "range": "0-6",
    "items": [
      { "label": "Glasgow Coma Scale", "opzioni": [
        { "punti": 0, "testo": "13-15" },
        { "punti": 1, "testo": "5-12" },
        { "punti": 2, "testo": "3-4" }
      ]},
      { "label": "Volume dell'emorragia", "opzioni": [{ "punti": 0, "testo": "< 30 cm3" }, { "punti": 1, "testo": ">= 30 cm3" }] },
      { "label": "Emorragia intraventricolare", "opzioni": [{ "punti": 0, "testo": "No" }, { "punti": 1, "testo": "Sì" }] },
      { "label": "Origine infratentoriale", "opzioni": [{ "punti": 0, "testo": "No" }, { "punti": 1, "testo": "Sì" }] },
      { "label": "Età", "opzioni": [{ "punti": 0, "testo": "< 80 anni" }, { "punti": 1, "testo": ">= 80 anni" }] }
    ],
    "interpretazione": [
      { "min": 0, "max": 0, "testo": "Mortalità a 30 giorni ~0% (coorte di derivazione)" },
      { "min": 1, "max": 1, "testo": "Mortalità a 30 giorni ~13%" },
      { "min": 2, "max": 2, "testo": "Mortalità a 30 giorni ~26%" },
      { "min": 3, "max": 3, "testo": "Mortalità a 30 giorni ~52%" },
      { "min": 4, "max": 4, "testo": "Mortalità a 30 giorni ~82%" },
      { "min": 5, "max": 6, "testo": "Mortalità a 30 giorni ~97-100%" }
    ]
  },
  "fonte": {
    "tipo": "pubblicazione_originale",
    "nome": "Hemphill JC 3rd, Bonovich DC, Besmertis L, Manley GT, Johnston SC. The ICH score: a simple, reliable grading scale for intracerebral hemorrhage. Stroke. 2001;32(4):891-897.",
    "url": "",
    "anno": 2001
  },
  "verifica": {
    "verificato_da": "Martino Longo",
    "data_verifica": "2026-11-18",
    "prossima_revisione": "2028-11-18"
  },
  "versione": 1
}
