        { "punti": 2, "testo": "Altamente sospetta" }
      ]},
      { "label": "ECG", "opzioni": [
        { "punti": 0, "testo": "Normale" },
        { "punti": 1, "testo": "Anomalia ST/T non specifica" },
        { "punti": 2, "testo": "Slivellamento ST significativo" }
      ]},
      { "label": "Età", "opzioni": [
        { "punti": 0, "testo": "< 45 anni" },
        { "punti": 1, "testo": "45-64 anni" },
        { "punti": 2, "testo": ">= 65 anni" }
      ]},
      { "label": "Fattori di rischio", "opzioni": [
        { "punti": 0, "testo": "Nessuno" },
        { "punti": 1, "testo": "1-2 fattori" },
        { "punti": 2, "testo": ">= 3 fattori, o anamnesi nota di malattia aterosclerotica" }
      ]},
      { "label": "Troponina", "opzioni": [
        { "punti": 0, "testo": "<= limite superiore di norma" },
        { "punti": 1, "testo": "1-3 volte il limite di norma" },
        { "punti": 2, "testo": "> 3 volte il limite di norma" }
      ]}
    ],
    "interpretazione": [
      { "min": 0, "max": 3, "testo": "Rischio basso (MACE a 6 settimane ~0.9-1.7%) — dimissione/osservazione breve ragionevole" },
      { "min": 4, "max": 6, "testo": "Rischio moderato — valutare ricovero/osservazione prolungata" },
      { "min": 7, "max": 10, "testo": "Rischio alto — consulenza cardiologica urgente" }
    ]
  },
